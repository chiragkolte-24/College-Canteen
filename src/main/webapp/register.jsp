<%@ include file="includes/header.jspf" %><section class="auth card"><h1>Create student account</h1><% if(request.getAttribute("error")!=null){ %><div class="error">${error}</div><% } %>
<form method="post" action="${pageContext.request.contextPath}/register"><label>Full name</label><input name="name" required><label>Email</label><input type="email" name="email" required><label>Password (minimum 6 characters)</label><input type="password" name="password" minlength="6" required><button>Register</button></form><p>Already registered? <a href="${pageContext.request.contextPath}/login">Login</a></p></section><%@ include file="includes/footer.jspf" %>
